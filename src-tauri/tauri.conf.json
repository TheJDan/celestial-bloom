{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Celestial Bloom",
  "version": "1.0.16",
  "identifier": "com.thejdan.celestialbloom",
  "build": {
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "bloom",
        "url": "index.html",
        "width": 1920,
        "height": 420,
        "x": 0,
        "y": 0,
        "decorations": false,
        "transparent": true,
        "backgroundColor": [
          0,
          0,
          0,
          0
        ],
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "focus": false,
        "skipTaskbar": true,
        "shadow": false,
        "visible": true,
        "dragDropEnabled": true
      },
      {
        "label": "settings",
        "create": false,
        "title": "Settings",
        "url": "settings.html",
        "width": 740,
        "height": 560,
        "decorations": false,
        "transparent": true,
        "backgroundColor": [
          0,
          0,
          0,
          0
        ],
        "resizable": true,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "alwaysOnTop": false,
        "visibleOnAllWorkspaces": false,
        "focus": true,
        "skipTaskbar": false,
        "shadow": true,
        "visible": false,
        "center": true
      },
      {
        "label": "overlay",
        "title": "Overlay",
        "url": "overlay.html",
        "width": 1920,
        "height": 1080,
        "x": 0,
        "y": 0,
        "decorations": false,
        "transparent": true,
        "backgroundColor": [
          0,
          0,
          0,
          0
        ],
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "focus": false,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false
      },
      {
        "label": "dock",
        "title": "Bloom Dock",
        "url": "dock.html",
        "width": 1920,
        "height": 600,
        "x": 0,
        "y": 480,
        "decorations": false,
        "transparent": true,
        "backgroundColor": [
          0,
          0,
          0,
          0
        ],
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "focus": false,
        "skipTaskbar": true,
        "shadow": false,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' ipc: http://ipc.localhost https://api.open-meteo.com https://geocoding-api.open-meteo.com https://ipapi.co http://ip-api.com https://bloom.sehaz.space https://lrclib.net ws://localhost:6123 ws://127.0.0.1:6123"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "publisher": "TheJDan",
    "copyright": "Copyright © 2026 TheJDan",
    "category": "Utility",
    "shortDescription": "Caelestia Dynamic Island & Shell for Windows",
    "longDescription": "Celestial Bloom brings the fluid Caelestia desktop experience to Windows 10/11 with native widgets, workspaces and dynamic theming.",
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {}
}
